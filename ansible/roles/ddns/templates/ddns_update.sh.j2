#!/usr/bin/env bash
set -eu

DYNU_HOSTNAME="{{ dynu_hostname }}"
DYNU_PASSWORD="{{ dynu_password }}"

response="$(
  curl -fsS "https://api.dynu.com/nic/update?hostname=${DYNU_HOSTNAME}&password=${DYNU_PASSWORD}"
)"

if [[ "$response" == good* || "$response" == nochg* ]]; then
  exit 0
fi

echo "Dynu update failed: $response" >&2
exit 1
